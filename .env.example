# Copy this file to .env and adjust values for local development.
GROUNDED_RAG_ENVIRONMENT=development
GROUNDED_RAG_DATA_DIR=data
GROUNDED_RAG_INDEX_DIR=indexes
GROUNDED_RAG_EMBEDDING_PROVIDER=local
GROUNDED_RAG_GENERATION_PROVIDER=local
GROUNDED_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GROUNDED_RAG_GENERATION_MODEL=local-deterministic
GROUNDED_RAG_CHUNK_SIZE=1000
GROUNDED_RAG_CHUNK_OVERLAP=150
GROUNDED_RAG_TOP_K=5
GROUNDED_RAG_MINIMUM_RETRIEVAL_SCORE=0.2

# Required only when either provider is set to openai. Never commit a real key.
GROUNDED_RAG_OPENAI_API_KEY=
